# =================================================================
# MARC TOPLU - Sunucu (VPS/VDS) Production Çevre Değişkenleri
# =================================================================
# Bu dosyayı sunucunuzda '.env' adıyla kopyalayın ve değerleri doldurun:
# cp .env.prod.example .env

# 1. Domain ve SSL Ayarları
# -----------------------------------------------------------------
# Kiraladığınız alan adı (Örn: marctoplu.com)
DOMAIN=marctoplu.com
# Let's Encrypt SSL bildirimleri için e-posta adresiniz
ACME_EMAIL=destek@marctoplu.com

# 2. PostgreSQL Veritabanı Ayarları
# -----------------------------------------------------------------
POSTGRES_DB=marctoken
POSTGRES_USER=marcuser
# Mutlaka güçlü, rastgele bir şifre belirleyin:
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_BELIRLEYIN

# 3. Firebase Kimlik Doğrulama ve Bildirim Ayarları
# -----------------------------------------------------------------
FIREBASE_PROJECT_ID=marctoplu
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=marctoplu.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=marctoplu.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=720742633366
NEXT_PUBLIC_FIREBASE_APP_ID=1:720742633366:web:0f21b2c188157d2fe517b7

# 4. iyzico Ayarları (İsteğe Bağlı)
# -----------------------------------------------------------------
# Web sitesinden şimdilik ödeme alınmayacaksa boş bırakabilirsiniz.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_CALLBACK_URL=https://api.marctoplu.com/api/payments/iyzico/callback

# 5. Uygulama İçi Satın Alma (IAP) Doğrulaması — ZORUNLU
# -----------------------------------------------------------------
# Anahtar dosyaları sunucuda secrets/ klasörüne konur (konteynerde /app/secrets).
# Bir platformun anahtarı eksikse o platformdaki satın almalar reddedilir.
# Kurulum adımları: docs/DEPLOYMENT.md → "Uygulama içi satın alma doğrulaması"
IAP_GOOGLE_SERVICE_ACCOUNT_PATH=/app/secrets/play-service-account.json
IAP_APPLE_ISSUER_ID=
IAP_APPLE_KEY_ID=
IAP_APPLE_PRIVATE_KEY_PATH=/app/secrets/apple-iap-key.p8
# App Review ve TestFlight satın almaları sandbox'ta olduğu için true kalmalı
IAP_APPLE_ALLOW_SANDBOX=true

# 6. Yönetici (Admin) Yetkilendirmesi
# -----------------------------------------------------------------
# Admin paneline (/admin) erişebilecek e-posta adresleri (virgülle ayırarak birden fazla eklenebilir):
ADMIN_EMAILS=admin@alanadiniz.com

