# =================================================================
# MARCTOPLU - Sunucu (VPS/VDS) Production Çevre Değişkenleri
# =================================================================
# Bu dosyayı sunucunuzda '.env' adıyla kopyalayın ve değerleri doldurun:
# cp .env.prod.example .env
# Adım adım kurulum: docs/DEPLOYMENT.md

# 1. Domain ve SSL Ayarları
# -----------------------------------------------------------------
# Alan adınız. Web DOMAIN'de, API api.DOMAIN'de yayınlanır; www.DOMAIN ana alan adına yönlenir.
DOMAIN=alanadiniz.com
# Let's Encrypt SSL bildirimleri için e-posta adresiniz
ACME_EMAIL=epostaniz@alanadiniz.com

# 2. PostgreSQL Veritabanı Ayarları
# -----------------------------------------------------------------
POSTGRES_DB=marctoken
POSTGRES_USER=marcuser
# Mutlaka güçlü, rastgele bir şifre belirleyin (örn. openssl rand -base64 32):
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_BELIRLEYIN

# 3. Firebase Kimlik Doğrulama ve Bildirim Ayarları
# -----------------------------------------------------------------
# Firebase Console → Proje Ayarları → Genel → Web uygulaması yapılandırması.
# Servis hesabı anahtarı ayrıca secrets/serviceAccountKey.json olarak konur.
FIREBASE_PROJECT_ID=firebase-proje-id
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=firebase-proje-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=firebase-proje-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# App Store linki (örn. https://apps.apple.com/app/uygulamaniz/id1234567890).
# Uygulama App Store'da değilken boş bırakın: web'deki App Store butonları gizlenir.
# Build sırasında gömülür; değiştirince frontend yeniden build edilmeli.
NEXT_PUBLIC_APP_STORE_URL=

# 4. iyzico Ayarları (askıda, isteğe bağlı)
# -----------------------------------------------------------------
# Web ödemesi şu an kapalıdır; web arayüzü satın alma için mobil uygulamaya yönlendirir. Boş bırakın.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_CALLBACK_URL=

# 5. Uygulama İçi Satın Alma (IAP) Doğrulaması — ZORUNLU
# -----------------------------------------------------------------
# Anahtar dosyaları sunucuda secrets/ klasörüne konur (konteynerde /app/secrets).
# Bir platformun anahtarı eksikse o platformdaki satın almalar reddedilir.
# Kurulum adımları: docs/DEPLOYMENT.md → "Uygulama İçi Satın Alma (IAP) Doğrulaması"
# Kendi mobil uygulamanızın paket adı / bundle ID'si:
IAP_GOOGLE_PLAY_PACKAGE_NAME=com.ornek.uygulama
IAP_APPLE_BUNDLE_ID=com.ornek.uygulama
IAP_GOOGLE_SERVICE_ACCOUNT_PATH=/app/secrets/play-service-account.json
IAP_APPLE_ISSUER_ID=
IAP_APPLE_KEY_ID=
IAP_APPLE_PRIVATE_KEY_PATH=/app/secrets/apple-iap-key.p8
# App Review ve TestFlight satın almaları sandbox'ta olduğu için true kalmalı
IAP_APPLE_ALLOW_SANDBOX=true

# 6. Yönetici (Admin) Yetkilendirmesi
# -----------------------------------------------------------------
# Admin paneline (/admin) erişebilecek e-posta adresleri (virgülle ayırarak birden fazla eklenebilir):
ADMIN_EMAILS=admin@alanadiniz.com
