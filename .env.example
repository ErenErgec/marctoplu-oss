# =================================================================
# MARCTOPLU - Yerel geliştirme (docker compose) çevre değişkenleri
# =================================================================
# docker compose bu dosyayı okumaz; kök dizinde '.env' adıyla kopyalayın:
#   cp .env.example .env
# Boş bıraktığınız değerler için docker-compose.yml içindeki varsayılanlar kullanılır.
# Sunucu (production) için .env.prod.example dosyasına bakın.

# Admin paneline (/admin) erişebilecek e-posta adresleri (virgülle ayrılır)
ADMIN_EMAILS=siz@example.com

# Firebase projeniz: Firebase Console → Proje Ayarları → Genel → Web uygulaması yapılandırması.
# Backend JWT doğrulaması da FIREBASE_PROJECT_ID'yi kullanır; ikisi aynı projeye ait olmalı.
# Bildirimler ve misafir temizliği için servis hesabı anahtarını secrets/serviceAccountKey.json olarak koyun.
FIREBASE_PROJECT_ID=firebase-proje-id
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=firebase-proje-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=firebase-proje-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# İsteğe bağlı: App Store linki (boşsa web'deki App Store butonları gizlenir)
NEXT_PUBLIC_APP_STORE_URL=

# -----------------------------------------------------------------
# Backend'i docker olmadan (dotnet run) çalıştırırken ayarlar
# -----------------------------------------------------------------
# dotnet bu dosyayı okumaz. Değerleri `dotnet user-secrets` ile (scripts/setup-local.sh)
# ya da ortam değişkeni olarak verin. Varsayılanlar appsettings.json içindedir.
#
# ConnectionStrings__Default=Host=localhost;Port=5433;Database=marctoken;Username=postgres;Password=postgres
# Firebase__ProjectId=firebase-proje-id
# App__AdminEmails=siz@example.com
# App__FrontendUrl=http://localhost:3000
# App__PythonExecutable=python3
# App__TokenCostPerIsbn=1
# App__WorkerPollSeconds=3
# App__RunningJobTimeoutSeconds=120
# App__MaxParallelJobs=3
# App__MaxIsbnsPerJob=20000
# App__IsbnCacheEnabled=true
# App__FileRetentionDays=7
# App__GuestRetentionDays=3
# App__FreeTrialTokens=5
# App__MaxTrialsPerIpPerDay=5
#
# Uygulama içi satın alma doğrulaması (bkz. docs/DEPLOYMENT.md §9):
# Iap__GooglePlayPackageName=com.ornek.uygulama
# Iap__GoogleServiceAccountPath=secrets/play-service-account.json
# Iap__AppleBundleId=com.ornek.uygulama
# Iap__AppleIssuerId=
# Iap__AppleKeyId=
# Iap__ApplePrivateKeyPath=secrets/apple-iap-key.p8
#
# iyzico (web ödemesi askıda; tek aktif ödeme kanalı mobil IAP):
# Iyzico__ApiKey=sandbox-api-key
# Iyzico__SecretKey=sandbox-secret
# Iyzico__BaseUrl=https://sandbox-api.iyzipay.com
# Iyzico__CallbackUrl=http://localhost:8080/api/payments/iyzico/callback
