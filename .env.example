# Backend (.NET) environment variables
ConnectionStrings__Default=Host=localhost;Port=5432;Database=marctoken;Username=postgres;Password=postgres
App__FrontendUrl=http://localhost:3000
App__TokenCostPerIsbn=1
App__PythonExecutable=python
App__WorkerPollSeconds=3
App__RunningJobTimeoutSeconds=120
App__MaxParallelJobs=3
App__FileRetentionDays=7
# Admin paneline erişmek için virgülle ayrılmış e-posta adresleri:
App__AdminEmails=admin@example.com,siz@example.com
# docker compose ile çalışırken aynı değeri kök .env dosyasına ADMIN_EMAILS olarak yazın:
# ADMIN_EMAILS=admin@example.com
Firebase__ProjectId=my-firebase-project-id
Iyzico__ApiKey=sandbox-api-key
Iyzico__SecretKey=sandbox-secret-key
Iyzico__BaseUrl=https://sandbox-api.iyzipay.com
Iyzico__CallbackUrl=http://localhost:8080/api/payments/iyzico/callback

# Production notlari:
# - Iyzico__BaseUrl production endpoint olmalidir (sandbox olmamali)
# - Iyzico__CallbackUrl HTTPS olmalidir

# Frontend (.env.local in frontend folder)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
